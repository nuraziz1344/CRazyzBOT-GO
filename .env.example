SESSION_FILE=data/session.db
LOG_LEVEL=error

# Command prefix for bot commands (default: /)
COMMAND_PREFIX=/

# Owner number
OWNER_NUMBER=628xxx

# Subscription database file (default: data/subscriptions.db)
SUBSCRIPTION_DB_FILE=data/subscriptions.db

# Minecraft servertap endpoint
MC_API_URL=
MC_API_KEY=

# BinderByte API key for shipping tracking
BINDERBYTE_API_KEY=

# Prayer notification configuration
# Either set PRAYER_CITY_ID directly or use PRAYER_CITY to lookup ID
PRAYER_CITY_ID=
PRAYER_CITY=
# Comma-separated keywords for group-based prayer subscriptions (optional)
PRAYER_GROUP_KEYWORDS=

# Sticker metadata (shown in WhatsApp)
STICKER_PACK_AUTHOR=CRazyzBOT
STICKER_PACK_NAME=CRazyz Stickers
