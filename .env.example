LOG_LEVEL=error

# Command prefix for bot commands (default: /)
COMMAND_PREFIX=/

# Owner number
OWNER_NUMBER=628xxx

# Postgres connection string used for both the WhatsApp session store and
# subscription storage. With the bundled docker-compose postgres service,
# host/user/pass/db must match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB below.
POSTGRES_DSN=postgres://crazyzbot:crazyzbot@localhost:5432/crazyzbot?sslmode=disable

# Credentials for the docker-compose postgres service (must match POSTGRES_DSN above)
POSTGRES_USER=crazyzbot
POSTGRES_PASSWORD=crazyzbot
POSTGRES_DB=crazyzbot

# Minecraft servertap endpoint
MC_API_URL=
MC_API_KEY=

# BinderByte API key for shipping tracking
BINDERBYTE_API_KEY=

# Minimum earthquake magnitude (SR) that triggers a notification to subscribers (default: 3.5)
EARTHQUAKE_MIN_MAGNITUDE=3.5

# Sticker metadata (shown in WhatsApp)
STICKER_PACK_AUTHOR=CRazyzBOT
STICKER_PACK_NAME=CRazyz Stickers

# Proxy configuration (for downloader/scraper)
# Set to "true" to enable proxy rotation for social media downloaders
# Useful when VPS blocks requests to scraper sites
PROXY_ENABLED=true
# Preferred proxy country code (ISO 3166-1 alpha-2). Default: ID (Indonesia)
PROXY_COUNTRY=ID
# How often to refresh the proxy pool (default: 30m)
# Format: Go duration string (e.g., 30m, 1h, 15m)
PROXY_REFRESH_INTERVAL=30m
