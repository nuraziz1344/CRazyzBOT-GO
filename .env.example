SESSION_FILE=data/session.db
LOG_LEVEL=error

# Command prefix for bot commands (default: /)
COMMAND_PREFIX=/

# user-part of target WhatsApp group JID (e.g. 120363198302441256)
GEMPA_ALERT_JID=

# Optional: override polling interval (e.g. 30s, 1m). Empty => 45s default.
GEMPA_ALERT_INTERVAL=

# Optional: override BMKG earthquake feed endpoint
GEMPA_ALERT_ENDPOINT=
